function createCubes(){gameState.cubes.forEach(c=>scene.remove(c));gameState.cubes=[];const placed=[];for(let i=0;i<6;i++){let px,pz,py,att=0,ok=false;while(att<150&&!ok){px=(Math.random()-0.5)*28000;pz=(Math.random()-0.5)*28000;py=getTerrainHeight(px,pz);if(py>=10){let good=true;for(let j=0;j<placed.length;j++){if(Math.sqrt((px-placed[j].x)**2+(pz-placed[j].z)**2)<2000){good=false;break;}}if(good)ok=true;}att++;}if(ok){placed.push({x:px,z:pz});const mat=new THREE.MeshStandardMaterial({color:0x8b00ff,metalness:0.8,roughness:0.2,emissive:0x4400aa,emissiveIntensity:0.6});const g=new THREE.Group(),sc=1.25;g.add(new THREE.Mesh(new THREE.CylinderGeometry(3*sc,3.5*sc,2*sc,8),mat));const tp=new THREE.Mesh(new THREE.BoxGeometry(4*sc,2*sc,4*sc),mat.clone());tp.position.y=2*sc;g.add(tp);const bl=new THREE.Mesh(new THREE.CylinderGeometry(0.5*sc,0.5*sc,3*sc,8),new THREE.MeshStandardMaterial({color:0x222222,metalness:0.9,roughness:0.1}));bl.rotation.x=Math.PI/2;bl.position.set(0,2*sc,2*sc);g.add(bl);let bury=Math.random()<0.6?40+Math.random()*80:0;g.position.set(px,py+2*sc-bury,pz);g.rotation.y=Math.random()*Math.PI*2;g.userData={hp:2,isShooter:true,isGround:true,lastShotTime:Math.random()*2,shootCooldown:2+Math.random()*1.5,scale:sc};scene.add(g);gameState.cubes.push(g);if(bury>0){const hg=new THREE.Group();const dp=new THREE.Mesh(new THREE.CircleGeometry(6,16),new THREE.MeshBasicMaterial({color:0x000000,side:THREE.DoubleSide}));dp.rotation.x=-Math.PI/2;dp.position.y=-2;hg.add(dp);const eg=new THREE.Mesh(new THREE.RingGeometry(6,10,16),new THREE.MeshStandardMaterial({color:0x2a2a2a,side:THREE.DoubleSide}));eg.rotation.x=-Math.PI/2;eg.position.y=0.5;hg.add(eg);hg.position.set(px,py+1,pz);hg.userData={isBeacon:true,isHole:true,linkedTurret:g};scene.add(hg);gameState.cubes.push(hg);}}}}

