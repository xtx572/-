<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
// ========== 匾额隐藏背面贴图设置 ==========
// 直接调用游戏同目录下的 1.png 和 2.png 文件
// 1.png → 南匾隐藏背面（曾志明题旁相框）
// 2.png → 北匾隐藏背面（满框）
const PLAQUE_SOUTH_IMAGE = 'data:image/png;base64,';
const PLAQUE_NORTH_IMAGE = 'data:image/png;base64,';
// ==========================================

// 检测本地协议，防止 file:// 导致跨域黑块
if (window.location.protocol === 'file:') {
  console.warn('⚠️ 警告：您正在使用 file:// 协议直接打开HTML。浏览器安全策略可能会阻止本地图片渲染到3D模型上(导致黑块)。建议使用本地服务器(如 VSCode Live Server)运行。');
}

let plaquePhotoImgSouth=null,plaquePhotoImgNorth=null;
let plaqueBackCtx=null,plaqueBackTexture=null;
let plaqueNorthRearCtx=null,plaqueNorthRearTexture=null;

function paintPlaquePhoto(){
  if(!plaquePhotoImgSouth||!plaqueBackCtx||!plaqueBackTexture)return;
  const x=plaqueBackCtx,img=plaquePhotoImgSouth;
  const AX=676,AY=59,AW=289,AH=202;
  x.fillStyle='#7d1a14';x.fillRect(AX,AY,AW,AH);
  if (img.width > 0 && img.height > 0) {
    const sc=Math.min((AW-20)/img.width,(AH-20)/img.height);
    const dw=img.width*sc,dh=img.height*sc;
    const dx=AX+(AW-dw)/2,dy=AY+(AH-dh)/2;
    x.drawImage(img,dx,dy,dw,dh);
    x.strokeStyle='#e9c26a';x.lineWidth=4;x.strokeRect(dx-5,dy-5,dw+10,dh+10);
  } else {
    x.fillStyle='red';x.font='bold 40px Arial';x.fillText('图片尺寸异常', AX+20, AY+100);
  }
  plaqueBackTexture.needsUpdate=true;
}
function paintPlaquePhotoNorth(){
  if(!plaquePhotoImgNorth||!plaqueNorthRearCtx||!plaqueNorthRearTexture)return;
  const x=plaqueNorthRearCtx,img=plaquePhotoImgNorth;
  const W=1024,H=320;
  if (img.width > 0 && img.height > 0) {
    const sc=Math.max(W/img.width,H/img.height);
    const dw=img.width*sc,dh=img.height*sc;
    x.drawImage(img,(W-dw)/2,(H-dh)/2,dw,dh);
    x.strokeStyle='#e9c26a';x.lineWidth=8;x.strokeRect(4,4,W-8,H-8);
  } else {
    x.fillStyle='red';x.font='bold 80px Arial';x.fillText('图片尺寸异常', 300, 160);
  }
  plaqueNorthRearTexture.needsUpdate=true;
}

let audioCtx=null,engineOsc=null,engineGain=null;
function initAudio(){if(audioCtx)return;audioCtx=new(window.AudioContext||window.webkitAudioContext)();startEngineSound();}
function playShootSound(){if(!audioCtx)return;const t=audioCtx.currentTime,bs=audioCtx.sampleRate*0.08,buf=audioCtx.createBuffer(1,bs,audioCtx.sampleRate),d=buf.getChannelData(0);for(let i=0;i<bs;i++)d[i]=(Math.random()*2-1)*Math.pow(1-i/bs,3);const n=audioCtx.createBufferSource();n.buffer=buf;const bp=audioCtx.createBiquadFilter();bp.type='bandpass';bp.frequency.value=1800;bp.Q.value=0.8;const g=audioCtx.createGain();g.gain.setValueAtTime(0.35,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.08);n.connect(bp).connect(g).connect(audioCtx.destination);n.start(t);n.stop(t+0.08);}
function playExplosionSound(){if(!audioCtx)return;const t=audioCtx.currentTime,o=audioCtx.createOscillator();o.type='sawtooth';o.frequency.setValueAtTime(120,t);o.frequency.exponentialRampToValueAtTime(20,t+0.5);const g=audioCtx.createGain();g.gain.setValueAtTime(0.5,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.5);o.connect(g).connect(audioCtx.destination);o.start(t);o.stop(t+0.5);}
function playEnemyShootSound(){if(!audioCtx)return;const t=audioCtx.currentTime,o=audioCtx.createOscillator();o.type='sawtooth';o.frequency.setValueAtTime(300,t);o.frequency.exponentialRampToValueAtTime(100,t+0.15);const g=audioCtx.createGain();g.gain.setValueAtTime(0.25,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.15);o.connect(g).connect(audioCtx.destination);o.start(t);o.stop(t+0.15);}
function playPlayerHitSound(){if(!audioCtx)return;const t=audioCtx.currentTime,o=audioCtx.createOscillator();o.type='sine';o.frequency.setValueAtTime(400,t);o.frequency.exponentialRampToValueAtTime(50,t+0.8);const g=audioCtx.createGain();g.gain.setValueAtTime(0.6,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.8);o.connect(g).connect(audioCtx.destination);o.start(t);o.stop(t+0.8);}
function playPickupSound(){if(!audioCtx)return;const t=audioCtx.currentTime,o=audioCtx.createOscillator();o.type='sine';o.frequency.setValueAtTime(523,t);o.frequency.setValueAtTime(659,t+0.1);o.frequency.setValueAtTime(784,t+0.2);const g=audioCtx.createGain();g.gain.setValueAtTime(0.3,t);g.gain.exponentialRampToValueAtTime(0.001,t+0.3);o.connect(g).connect(audioCtx.destination);o.start(t);o.stop(t+0.3);}
function playVictorySound(){if(!audioCtx)return;const t=audioCtx.currentTime;[523,659,784,1047].forEach((f,i)=>{const o=audioCtx.createOscillator();o.type='triangle';o.frequency.value=f;const g=audioCtx.createGain();g.gain.setValueAtTime(0,t+i*0.15);g.gain.linearRampToValueAtTime(0.3,t+i*0.15+0.05);g.gain.exponentialRampToValueAtTime(0.001,t+i*0.15+0.4);o.connect(g).connect(audioCtx.destination);o.start(t+i*0.15);o.stop(t+i*0.15+0.4);});}
function playEasterEggSound(){if(!audioCtx)return;const t=audioCtx.currentTime;[261,329,392,523,659,784,1047,1318].forEach((f,i)=>{const o=audioCtx.createOscillator();o.type='sine';o.frequency.value=f;const g=audioCtx.createGain();g.gain.setValueAtTime(0,t+i*0.2);g.gain.linearRampToValueAtTime(0.2,t+i*0.2+0.08);g.gain.exponentialRampToValueAtTime(0.001,t+i*0.2+0.8);o.connect(g).connect(audioCtx.destination);o.start(t+i*0.2);o.stop(t+i*0.2+0.8);});}
function startEngineSound(){if(!audioCtx)return;engineOsc=audioCtx.createOscillator();engineOsc.type='sawtooth';engineOsc.frequency.value=65;const o2=audioCtx.createOscillator();o2.type='triangle';o2.frequency.value=98;const lp=audioCtx.createBiquadFilter();lp.type='lowpass';lp.frequency.value=250;lp.Q.value=2;engineGain=audioCtx.createGain();engineGain.gain.value=0.06;engineOsc.connect(lp);o2.connect(lp);lp.connect(engineGain).connect(audioCtx.destination);engineOsc.start();o2.start();const lfo=audioCtx.createOscillator();lfo.type='sine';lfo.frequency.value=4;const lg=audioCtx.createGain();lg.gain.value=8;lfo.connect(lg).connect(engineOsc.frequency);lfo.start();}

function createDaySkyTexture(){const c=document.createElement('canvas');c.width=1024;c.height=1024;const x=c.getContext('2d');const g=x.createLinearGradient(0,0,0,1024);g.addColorStop(0,'#2a60a9');g.addColorStop(0.45,'#87ceeb');g.addColorStop(0.8,'#e0f0ff');g.addColorStop(1,'#fff');x.fillStyle=g;x.fillRect(0,0,1024,1024);for(let i=0;i<30;i++){x.fillStyle=`rgba(255,255,255,${0.4+Math.random()*0.4})`;x.beginPath();const cx=Math.random()*1024,cy=Math.random()*500;x.arc(cx,cy,Math.random()*60+20,0,Math.PI*2);x.fill();}return new THREE.CanvasTexture(c);}

function getTerrainHeight(x,z){
  let h=0;
  h+=Math.sin(x*0.003)*Math.cos(z*0.003)*120;
  h+=Math.sin(x*0.009+1.5)*Math.cos(z*0.006)*60;
  function pk(px,pz,ht,r){let d=Math.sqrt((x-px)**2+(z-pz)**2);if(d<r*1.5)return Math.max(0,ht*Math.exp(-d/(r*0.35)));return 0;}
  h+=pk(-7500,-7500,2500,2400);
  h+=pk(7500,-6000,2200,2100);
  h+=pk(-6000,7500,2800,2700);
  h+=pk(9000,6000,2000,1800);
  h+=pk(0,-12000,2400,3000);
  h+=pk(0,12000,2400,3000);
  let cx=4500*Math.sin(z*0.0008)+1500*Math.sin(z*0.0025);
  let dc=Math.abs(x-cx);
  if(dc<1200){let f=dc/1200;h=h*f;h=Math.max(0,h-600*(1-f));}
  return Math.max(0,h);
}

function createGateTower(){
  const group=new THREE.Group();group.name='gate-tower';
  const add=(g,m,x,y,z)=>{const o=new THREE.Mesh(g,m);o.position.set(x||0,y||0,z||0);group.add(o);return o;};
  const canvasTex=(w,h,draw)=>{const c=document.createElement('canvas');c.width=w;c.height=h;draw(c.getContext('2d'),w,h);const t=new THREE.CanvasTexture(c);t.encoding=THREE.sRGBEncoding;t.wrapS=t.wrapT=THREE.RepeatWrapping;return t;};
  const doorTex=canvasTex(256,256,x=>{x.fillStyle='#8d2a20';x.fillRect(0,0,256,256);x.fillStyle='#d9a44a';for(let i=0;i<7;i++)for(let j=0;j<7;j++){x.beginPath();x.arc(20+i*36,20+j*36,7,0,7);x.fill();}});
  const latticeTex=canvasTex(128,128,x=>{x.fillStyle='#5a1712';x.fillRect(0,0,128,128);x.strokeStyle='#e2b25e';x.lineWidth=5;for(let i=1;i<4;i++){x.beginPath();x.moveTo(i*32,0);x.lineTo(i*32,128);x.stroke();x.beginPath();x.moveTo(0,i*32);x.lineTo(128,i*32);x.stroke();}});
  const plaqueTex=canvasTex(1024,320,(x,w,h)=>{x.fillStyle='#7d1a14';x.fillRect(0,0,w,h);x.strokeStyle='#e9c26a';x.lineWidth=18;x.strokeRect(24,24,w-48,h-48);x.lineWidth=6;x.strokeRect(56,56,w-112,h-112);x.fillStyle='#f3cf7a';x.font='bold 150px "KaiTi","STKaiti",serif';x.textAlign='center';x.textBaseline='middle';x.fillText('雄镇南天',w/2,h/2+8);});

  const plaqueNorthRearTex=(()=>{
    const c=document.createElement('canvas');c.width=1024;c.height=320;
    const x=c.getContext('2d');
    x.fillStyle='#5a1712';x.fillRect(0,0,1024,320);
    x.strokeStyle='#e9c26a';x.lineWidth=10;x.strokeRect(5,5,1014,310);
    x.fillStyle='#e9c26a';x.font='bold 60px "KaiTi","STKaiti",serif';
    x.textAlign='center';x.textBaseline='middle';
    x.fillText('📷 隐藏背面 · 待贴图',512,160);
    plaqueNorthRearCtx=x;
    plaqueNorthRearTexture=new THREE.CanvasTexture(c);
    plaqueNorthRearTexture.encoding=THREE.sRGBEncoding;
    if(PLAQUE_NORTH_IMAGE){
      const img=new Image();
      img.crossOrigin = "anonymous";
      img.onload=function(){plaquePhotoImgNorth=img;paintPlaquePhotoNorth();};
      img.onerror=function(){
        console.error(`❌ 北匾图片加载失败: ${PLAQUE_NORTH_IMAGE}，请检查文件是否存在于同一目录！`);
        if(plaqueNorthRearCtx) {
          plaqueNorthRearCtx.fillStyle = 'red';
          plaqueNorthRearCtx.font = 'bold 80px Arial';
          plaqueNorthRearCtx.fillText('未找到 2.png!', 512, 160);
          plaqueNorthRearTexture.needsUpdate = true;
        }
      };
      img.src=PLAQUE_NORTH_IMAGE;
    }else if(plaquePhotoImgNorth){paintPlaquePhotoNorth();}
    return plaqueNorthRearTexture;
  })();

  const plaqueSouthTex=canvasTex(1024,320,(x,w,h)=>{x.fillStyle='#7d1a14';x.fillRect(0,0,w,h);x.strokeStyle='#e9c26a';x.lineWidth=18;x.strokeRect(24,24,w-48,h-48);x.lineWidth=6;x.strokeRect(56,56,w-112,h-112);x.fillStyle='#f3cf7a';x.font='bold 150px "KaiTi","STKaiti",serif';x.textAlign='center';x.textBaseline='middle';x.fillText('没移北斗',w/2,h/2+8);});

  const plaqueRearTex=(()=>{
    const c=document.createElement('canvas');c.width=1024;c.height=320;
    const x=c.getContext('2d');
    x.fillStyle='#7d1a14';x.fillRect(0,0,1024,320);
    x.strokeStyle='#e9c26a';x.lineWidth=18;x.strokeRect(24,24,976,272);
