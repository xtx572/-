  const sc=[{a:0,d:1500,h:2000},{a:Math.PI/2,d:1500,h:2200},{a:Math.PI,d:1500,h:2500},{a:-Math.PI/2,d:1500,h:1800}];
  for(let d=0;d<4;d++){const pd=new THREE.Vector3(Math.sin(sc[d].a),0,Math.cos(sc[d].a)).normalize();for(let i=0;i<5;i++){const ep=createEnemyPlane();const oa=(i/5)*Math.PI*2+Math.random()*0.5,od=30+Math.random()*40;ep.position.set(pos.x+Math.sin(sc[d].a)*sc[d].d+Math.sin(oa)*od,sc[d].h+(Math.random()-0.5)*30,pos.z+Math.cos(sc[d].a)*sc[d].d+Math.cos(oa)*od);const lt=ep.position.clone().add(pd.clone().multiplyScalar(100));ep.lookAt(lt.x,lt.y,lt.z);ep.userData={hp:5,isShooter:true,lastShotTime:0,shootCooldown:2.5+Math.random(),isDying:false,homePos:ep.position.clone(),patrolDir:pd.clone(),patrolState:'outbound',patrolSpeed:105+Math.random()*45};scene.add(ep);gameState.enemyPlanes.push(ep);}}
