function updateUI(){document.getElementById('hitCount').textContent=gameState.hitCount;document.getElementById('targetDisplay').textContent=6;document.getElementById('planeCount').textContent=gameState.enemyPlanesDestroyed;}
function updateHealthBar(){document.getElementById('healthFill').style.width=gameState.playerHealth+'%';document.getElementById('healthText').textContent=Math.ceil(gameState.playerHealth);}
function damagePlayer(amt){return;if(gameState.gameOver)return;gameState.playerHealth-=amt;updateHealthBar();playPlayerHitSound();document.getElementById('damageFlash').style.opacity='1';setTimeout(()=>document.getElementById('damageFlash').style.opacity='0',300);if(gameState.playerHealth<=0){gameState.playerHealth=0;updateHealthBar();gameState.gameOver=true;document.getElementById('gameOver').style.display='block';}}
function restartGame(){document.getElementById('gameOver').style.display='none';document.getElementById('victory').style.display='none';startLevel();}

function shootPlayerBullet(){if(gameState.gameOver)return;const now=performance.now()/1000;if(now-lastShotTime<SHOT_CD)return;lastShotTime=now;const dir=new THREE.Vector3(-Math.sin(yaw)*Math.cos(pitch),Math.sin(pitch),-Math.cos(yaw)*Math.cos(pitch)).normalize();const b=new THREE.Mesh(bulletGeo,playerBulletMat);const mo=new THREE.Vector3(0,0,-3).applyQuaternion(playerPlane.quaternion);b.position.copy(playerPlane.position).add(mo);b.userData={vel:dir.clone().multiplyScalar(PLAYER_BULLET_SPEED),born:now};scene.add(b);gameState.playerBullets.push(b);playShootSound();}
function dropBomb(){if(gameState.gameOver||!playerPlane)return;const now=performance.now()/1000;if(now-lastBombTime<BOMB_CD)return;lastBombTime=now;const b=new THREE.Mesh(bulletGeo,bombMat);const doff=new THREE.Vector3(0,-1.5,0).applyQuaternion(playerPlane.quaternion);b.position.copy(playerPlane.position).add(doff);const fwd=new THREE.Vector3(-Math.sin(yaw)*Math.cos(pitch),Math.sin(pitch),-Math.cos(yaw)*Math.cos(pitch)).normalize();b.userData={vel:fwd.clone().multiplyScalar(currentSpeed*1.5).add(new THREE.Vector3(0,120,0)),born:now,isBomb:true};scene.add(b);gameState.playerBullets.push(b);playShootSound();}
function shootEnemyBullet(cube){if(gameState.gameOver)return;const now=performance.now()/1000;if(now-cube.userData.lastShotTime<cube.userData.shootCooldown)return;cube.userData.lastShotTime=now;const pt=cube.position.distanceTo(pos)/ENEMY_BULLET_SPEED;const pp=pos.clone().add(new THREE.Vector3(-Math.sin(yaw)*Math.cos(pitch),Math.sin(pitch),-Math.cos(yaw)*Math.cos(pitch)).multiplyScalar(currentSpeed*pt*0.3));const ad=new THREE.Vector3().subVectors(pp,cube.position).normalize();const b=new THREE.Mesh(bulletGeo,enemyBulletMat);b.position.copy(cube.position);b.userData={vel:ad.clone().multiplyScalar(ENEMY_BULLET_SPEED),born:now};scene.add(b);gameState.enemyBullets.push(b);playEnemyShootSound();}
function createExplosion(position,isLarge=false){playExplosionSound();const count=isLarge?20:12,geo=isLarge?expGeoL:expGeoS,mat=isLarge?expMatD:expMatO;for(let i=0;i<count;i++){if(gameState.explosionParticles.length>=MAX_EXP){const old=gameState.explosionParticles.shift();scene.remove(old);}const p=new THREE.Mesh(geo,mat);p.position.copy(position);const spd=isLarge?150:90;p.userData={vel:new THREE.Vector3((Math.random()-0.5)*spd,Math.random()*spd*0.8,(Math.random()-0.5)*spd),life:1};scene.add(p);gameState.explosionParticles.push(p);}const swm=new THREE.MeshBasicMaterial({color:isLarge?0xaaaaaa:0xffffff,transparent:true,opacity:0.9,side:THREE.BackSide});const sw=new THREE.Mesh(swGeo,swm);sw.position.copy(position);sw.userData={life:1,maxScale:isLarge?80:40};scene.add(sw);gameState.shockwaves.push(sw);shakeIntensity=isLarge?8:3;shakeTimer=isLarge?0.8:0.4;}

let yaw=0,pitch=0;const pos=new THREE.Vector3(0,1500,0);let currentSpeed=BASE_SPEED;
const ROT_SPEED=2.0,MOUSE_SENS=0.002;let locked=false;
const keys={w:false,a:false,s:false,d:false};let shiftHeld=false,ctrlHeld=false,shooting=false;
document.getElementById('clickHint').addEventListener('click',()=>{renderer.domElement.requestPointerLock();initAudio();});
document.addEventListener('pointerlockchange',()=>{locked=document.pointerLockElement===renderer.domElement;document.getElementById('clickHint').style.display=locked?'none':'block';});
document.addEventListener('mousemove',e=>{if(!locked)return;yaw-=e.movementX*MOUSE_SENS;pitch-=e.movementY*MOUSE_SENS;pitch=Math.max(-Math.PI/2+0.01,Math.min(Math.PI/2-0.01,pitch));});
document.addEventListener('mousedown',e=>{if(locked&&e.button===0)shooting=true;});
document.addEventListener('mouseup',e=>{if(e.button===0)shooting=false;});
window.addEventListener('keydown',e=>{const k=e.key.toLowerCase();if(k in keys)keys[k]=true;if(k==='shift')shiftHeld=true;if(k==='control'){ctrlHeld=true;e.preventDefault();}if(k==='r'&&!gameState.gameOver){pos.set(0,1500,0);yaw=0;pitch=0;}if(k==='f'&&!gameState.gameOver)dropBomb();if(k==='e'&&!gameState.gameOver)tryInteract();});
window.addEventListener('keyup',e=>{const k=e.key.toLowerCase();if(k in keys)keys[k]=false;if(k==='shift')shiftHeld=false;if(k==='control')ctrlHeld=false;});
window.addEventListener('resize',()=>{camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();renderer.setSize(innerWidth,innerHeight);});

const mmC=document.getElementById('minimap'),mmX=mmC.getContext('2d');
function updateMinimap(){const w=200,h=200;mmX.fillStyle='rgba(0,20,0,0.85)';mmX.fillRect(0,0,w,h);const s=w/30000,cx=w/2,cy=h/2;
gameState.cubes.forEach(c=>{if(c.userData.isGround){mmX.fillStyle='#ff0000';mmX.beginPath();mmX.arc(cx+c.position.x*s,cy+c.position.z*s,2.5,0,Math.PI*2);mmX.fill();}});gameState.enemyPlanes.forEach(ep=>{if(!ep.userData.isDying){const mx=cx+ep.position.x*s,my=cy+ep.position.z*s;mmX.fillStyle='#ffff00';mmX.strokeStyle='#ff0000';mmX.lineWidth=2;mmX.beginPath();mmX.moveTo(mx,my-6);mmX.lineTo(mx-5,my+4);mmX.lineTo(mx+5,my+4);mmX.closePath();mmX.fill();mmX.stroke();}});if(bodhisattvaObj&&!easterEggTriggered){mmX.fillStyle='#ffd700';mmX.beginPath();mmX.arc(cx,cy,4,0,Math.PI*2);mmX.fill();}
if(guanyinObj){const mgx=cx+guanyinObj.position.x*s,mgy=cy+guanyinObj.position.z*s;mmX.fillStyle='#ffffff';mmX.beginPath();mmX.arc(mgx,mgy,6,0,Math.PI*2);mmX.fill();mmX.strokeStyle='#ffd700';mmX.lineWidth=2;mmX.beginPath();mmX.arc(mgx,mgy,9,0,Math.PI*2);mmX.stroke();mmX.fillStyle='#ffd700';mmX.font='bold 10px sans-serif';mmX.textAlign='center';mmX.fillText('观音',mgx,mgy-12);}
const px=cx+pos.x*s,py=cy+pos.z*s;mmX.fillStyle='#00ff00';mmX.beginPath();mmX.arc(px,py,4,0,Math.PI*2);mmX.fill();mmX.strokeStyle='#00ff00';mmX.lineWidth=2;mmX.beginPath();mmX.moveTo(px,py);mmX.lineTo(px-Math.sin(yaw)*12,py-Math.cos(yaw)*12);mmX.stroke();}

const clock=new THREE.Clock();
function animate(){
  requestAnimationFrame(animate);
  if(gameState.gameOver){camera.position.copy(camCurrentPos);camera.lookAt(camCurrentLookAt);renderer.render(scene,camera);return;}
  const dt=Math.min(clock.getDelta(),0.05),now=performance.now()/1000;
  currentSpeed=shiftHeld&&!ctrlHeld?BASE_SPEED*15:(ctrlHeld&&!shiftHeld?BASE_SPEED*0.01:BASE_SPEED);
  document.getElementById('speedText').textContent=currentSpeed.toFixed(1);
  if(shooting)shootPlayerBullet();
  if(keys.a)yaw+=ROT_SPEED*dt;if(keys.d)yaw-=ROT_SPEED*dt;if(keys.w)pitch+=ROT_SPEED*dt;if(keys.s)pitch-=ROT_SPEED*dt;
  pitch=Math.max(-Math.PI/2+0.01,Math.min(Math.PI/2-0.01,pitch));
  const fwd=new THREE.Vector3(-Math.sin(yaw)*Math.cos(pitch),Math.sin(pitch),-Math.cos(yaw)*Math.cos(pitch));
  pos.add(fwd.clone().multiplyScalar(currentSpeed*dt));
